{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/v1-*.ts", "playwright.config.ts", "vite.config.ts"],
  "exclude": ["src/**/*.test.ts"]
}
